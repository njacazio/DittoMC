PROJECT_NAME           = "Ditto"
PROJECT_BRIEF          = "Fast minimum-bias event generation"
PROJECT_LOGO           = .logo.png

OUTPUT_DIRECTORY       = docs/generated

INPUT                  = docs \
                         Generation \
                         Tuning \
                         Validation \
                         ValidationTune

RECURSIVE              = YES

FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.cxx \
                         *.cpp \
                         *.md

USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

BUILTIN_STL_SUPPORT    = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# ---------------------------------------------------------------------------
# HTML
# ---------------------------------------------------------------------------

GENERATE_HTML          = YES
GENERATE_LATEX         = NO

GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO

HTML_EXTRA_STYLESHEET  = docs/ditto.css

# ---------------------------------------------------------------------------
# Markdown
# ---------------------------------------------------------------------------

MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3

# ---------------------------------------------------------------------------
# Diagrams
# ---------------------------------------------------------------------------

HAVE_DOT               = YES
CLASS_DIAGRAMS         = YES

CALL_GRAPH             = NO
CALLER_GRAPH           = NO

# ---------------------------------------------------------------------------
# Warnings
# ---------------------------------------------------------------------------

QUIET                  = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO